{
  "manifest_version": 3,
  "name": "Anti-Fraud - phát hiện lừa đảo",
  "version": "0.0.1",
  "description": "Cảnh báo trang lừa đảo bằng danh sách tải sẵn, tra hoàn toàn trong máy.",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://anti-fraud.omelet.tech/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Anti-Fraud",
    "default_popup": "popup/index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
