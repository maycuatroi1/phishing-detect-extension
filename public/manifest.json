{
  "manifest_version": 3,
  "name": "Anti-Fraud - phát hiện lừa đảo",
  "version": "0.0.1",
  "description": "Bộ khung MV3 của cụm phishing-detect. Chưa có tier phát hiện nào được bật.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Anti-Fraud",
    "default_popup": "popup/index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
